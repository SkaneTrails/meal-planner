{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "rangeStrategy": "replace",
  "rebaseWhen": "behind-base-branch",
  "branchPrefix": "renovate/",
  "labels": [
    "🧹 renovate",
    "📦 type: dependencies"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "🤖 Renovate Dependency Dashboard",
  "minimumReleaseAge": "3 days",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Auto-merge minor, patch, pin, and digest updates",
      "automerge": true,
      "platformAutomerge": true,
      "automergeStrategy": "squash",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ]
    },
    {
      "matchDatasources": [
        "pypi"
      ],
      "registryUrls": [
        "https://pypi.org/simple"
      ]
    },
    {
      "groupName": "Python testing tools",
      "groupSlug": "python-testing",
      "matchPackageNames": [
        "pytest*",
        "coverage",
        "pytest-cov",
        "pytest-mock",
        "pytest-xdist"
      ],
      "matchManagers": [
        "pep621",
        "pip_requirements",
        "pip-compile"
      ]
    },
    {
      "groupName": "Linting tools",
      "groupSlug": "linting",
      "matchPackageNames": [
        "ruff",
        "deptry",
        "prek"
      ],
      "matchManagers": [
        "pep621",
        "pip_requirements",
        "pip-compile"
      ]
    },
    {
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "🔧 type: ci"
      ]
    },
    {
      "groupName": "Pre-commit hooks",
      "groupSlug": "pre-commit",
      "matchManagers": [
        "pre-commit"
      ],
      "addLabels": [
        "🔧 type: ci"
      ]
    },
    {
      "description": "NativeWind 4 only supports Tailwind CSS v3",
      "matchPackageNames": [
        "tailwindcss"
      ],
      "matchFileNames": [
        "mobile/**"
      ],
      "allowedVersions": "<4.0.0"
    },
    {
      "description": "Expo SDK 58 pins these; they only change together via `npx expo install --fix` (an SDK upgrade). Newer versions broke the EAS Android build",
      "matchFileNames": [
        "mobile/**"
      ],
      "matchPackageNames": [
        "react",
        "react-dom",
        "react-native",
        "@react-native-async-storage/async-storage",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-svg",
        "react-native-worklets",
        "typescript",
        "@types/react",
        "@types/react-dom"
      ],
      "enabled": false
    },
    {
      "description": "Expo packages track the SDK major (58); moving to 59 is an SDK upgrade, not a routine bump",
      "matchFileNames": [
        "mobile/**"
      ],
      "matchPackageNames": [
        "expo",
        "/^expo-/",
        "/^@expo\\//",
        "babel-preset-expo"
      ],
      "allowedVersions": "<59.0.0"
    },
    {
      "description": "Expo SDK 58 accepts @expo/vector-icons ^15 (own version line, not the SDK major). Must stay after the Expo cap above so it overrides it",
      "matchFileNames": [
        "mobile/**"
      ],
      "matchPackageNames": [
        "@expo/vector-icons"
      ],
      "allowedVersions": "<16.0.0"
    },
    {
      "description": "The NativeWind, css-interop and Worklets Babel plugins Expo 58 bundles with only accept Babel 7; Babel 8 breaks the native (EAS) bundle",
      "matchPackageNames": [
        "@babel/core"
      ],
      "matchFileNames": [
        "mobile/**"
      ],
      "allowedVersions": "<8.0.0"
    },
    {
      "description": "setup-trivy digest lookup broken post-compromise; pinned to verified SHA",
      "matchPackageNames": [
        "aquasecurity/setup-trivy"
      ],
      "enabled": false
    }
  ]
}
