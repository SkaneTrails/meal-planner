{
  "expo": {
    "name": "Aroma",
    "slug": "meal-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mealplanner",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8A87C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aroma.mealplanner"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#E8A87C"
      },
      "package": "com.aroma.mealplanner",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Aroma",
      "shortName": "Aroma",
      "description": "Plan your weekly meals and generate grocery lists",
      "themeColor": "#4A3728",
      "backgroundColor": "#F5E6D3"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Aroma to access your photos to set recipe images.",
          "cameraPermission": "Allow Aroma to use your camera to take recipe photos.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "08aaae84-f931-4fea-a641-c6fd49016ea0"
      }
    },
    "owner": "aroma-team"
  }
}
